+function d2_member_present(name)
+	for _, member in pairs(windower.ffxi.get_party()) do
+		if type(member) == 'table' and member.name == name and member.mob ~= nil then
+			local mob = windower.ffxi.get_mob_by_name(name)
+			if mob and mob.in_party and mob.distance and math.sqrt(mob.distance) < 19 then
+				return true
+			end
+		end
+	end
+	return false
+end
+
+function d2_ordered_targets()
+	local player = windower.ffxi.get_player()
+	local found = {}
+
+	for key, member in pairs(windower.ffxi.get_party()) do
+		if type(member) == 'table' and member.name and player and member.name ~= player.name
+			and d2_member_present(member.name) then
+			table.insert(found, {key = tostring(key), name = member.name})
+		end
+	end
+
+	table.sort(found, function(left, right)
+		return left.key < right.key
+	end)
+
+	local targets = {}
+	for _, entry in ipairs(found) do
+		table.insert(targets, entry.name)
+	end
+	return targets
+end
+
+function d2_wait_action_ready(timeout)
+	local elapsed = 0
+	while elapsed < timeout and not d2_cancelled do
+		local player = windower.ffxi.get_player()
+		if player and S{0, 1}:contains(player.status) and not d2_cast_started then
+			return true
+		end
+		coroutine.sleep(0.25)
+		elapsed = elapsed + 0.25
+	end
+	return false
+end
+
+function d2_wait_cast_start(timeout)
+	local elapsed = 0
+	while elapsed < timeout and not d2_cancelled do
+		local recasts = windower.ffxi.get_spell_recasts()
+		if d2_cast_started or (recasts and recasts[262] and recasts[262] > 0) then
+			return true
+		end
+		coroutine.sleep(0.25)
+		elapsed = elapsed + 0.25
+	end
+	return false
+end
+
+function d2_wait_target_gone(name, timeout)
+	local elapsed = 0
+	while elapsed < timeout and not d2_cancelled do
+		if not d2_member_present(name) then
+			return true
+		end
+		coroutine.sleep(0.25)
+		elapsed = elapsed + 0.25
+	end
+	return false
+end
+
+function d2_cast_target(name)
+	for attempt = 1, settings.d2_retry_count do
+		if d2_cancelled or not d2_member_present(name) then
+			return not d2_member_present(name)
+		end
+
+		check_mp_rest(262)
+		if not d2_wait_action_ready(settings.d2_start_timeout) then
+			atc('[D2] ' .. name .. ' is waiting for the action lock (' .. attempt .. '/' .. settings.d2_retry_count .. ').')
+		else
+			d2_current_target = name
+			d2_cast_started = false
+			d2_cast_finished = false
+			atc('[D2] Warp II -> ' .. name .. ' (' .. attempt .. '/' .. settings.d2_retry_count .. ')')
+			windower.send_command('input /ma "Warp II" "' .. name .. '"')
+
+			if not d2_wait_cast_start(settings.d2_start_timeout) then
+				atc('[D2] Cast did not start for ' .. name .. '; retrying.')
+			elseif d2_wait_target_gone(name, settings.d2_success_timeout) then
+				atc('[D2] Confirmed ' .. name .. ' warped.')
+				d2_current_target = nil
+				d2_cast_started = false
+				d2_cast_finished = false
+				coroutine.sleep(settings.d2_post_cast_delay)
+				return true
+			else
+				atc('[D2] No departure confirmation for ' .. name .. '; retrying.')
+			end
+		end
+
+		d2_current_target = nil
+		d2_cast_started = false
+		d2_cast_finished = false
+		coroutine.sleep(1)
+	end
+	return false
+end
+
+function d2_run(targets, warp_self)
+	if d2_active then
+		atc('[D2] A Warp II queue is already running. Use //mc d2 status or //mc d2 cancel.')
+		return
+	end
+
+	local player = windower.ffxi.get_player()
+	local spells = windower.ffxi.get_spells()
+	if not player or not S{player.main_job_id, player.sub_job_id}:contains(4)
+		or not spells or not spells[261] or not spells[262] then
+		atc('[D2] Requires BLM main/sub with Warp and Warp II learned.')
+		return
+	end
+
+	d2_active = true
+	d2_cancelled = false
+	d2_failed = {}
+
+	for _, name in ipairs(targets) do
+		if d2_cancelled then
+			break
+		end
+		if not d2_cast_target(name) then
+			table.insert(d2_failed, name)
+			atc('[D2] FAILED: ' .. name)
+		end
+	end
+
+	d2_current_target = nil
+	d2_cast_started = false
+	d2_cast_finished = false
+	d2_active = false
+
+	if d2_cancelled then
+		atc('[D2] Queue cancelled; caster will remain.')
+		return
+	end
+
+	if #d2_failed > 0 then
+		atc('[D2] Caster held. Failed targets: ' .. table.concat(d2_failed, ', ') .. '. Use //mc d2 retry.')
+		return
+	end
+
+	if warp_self then
+		check_mp_rest(261)
+		if d2_wait_action_ready(settings.d2_start_timeout) then
+			coroutine.sleep(settings.d2_post_cast_delay)
+			atc('[D2] All recipients confirmed. Warping caster.')
+			windower.send_command('input /ma "Warp" <me>')
+		else
+			atc('[D2] Caster held because the final action lock did not clear.')
+		end
+	end
+end
+
+function d2()
+	d2_run(d2_ordered_targets(), true)
+end
+
+function d2_retry()
+	if d2_active then
+		atc('[D2] Queue is still active.')
+		return
+	end
+
+	local retry_targets = {}
+	for _, name in ipairs(d2_failed) do
+		if d2_member_present(name) then
+			table.insert(retry_targets, name)
+		end
+	end
+
+	if #retry_targets == 0 then
+		atc('[D2] No failed nearby targets remain. Use //mc d2 for a fresh queue.')
+		d2_failed = {}
+		return
+	end
+	d2_run(retry_targets, true)
+end
+
+function d2_cancel()
+	if not d2_active then
+		atc('[D2] No queue is running.')
+		return
+	end
+	d2_cancelled = true
+	atc('[D2] Cancellation requested; caster will remain.')
+end
+
+function d2_status()
+	if d2_active then
+		atc('[D2] ACTIVE' .. (d2_current_target and (': ' .. d2_current_target) or ''))
+	elseif #d2_failed > 0 then
+		atc('[D2] IDLE. Failed targets: ' .. table.concat(d2_failed, ', '))
+	else
+		atc('[D2] IDLE. No pending failures.')
+	end
+end
