+
+function utils.cleanup_orphaned_textBoxes()
+    local current = {}
+    for _,text_box in pairs(hb.txts) do
+        current[text_box] = true
+    end
+
+    local prefix = _addon.name..'_gensym_'
+    for i = #windower.text.saved_texts, 1, -1 do
+        local text_box = windower.text.saved_texts[i]
+        local name = text_box and text_box._name
+        if name and name:sub(1, #prefix) == prefix and not current[text_box] then
+            text_box:destroy()
+        end
+    end
 end
 
 

