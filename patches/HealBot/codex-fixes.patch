+function buffs.register_removal_no_effect(target, removalSpellName)
+    if target == nil or target.name == nil then return end
+
+    local known = buffs.debuffList[target.name]
+    if known == nil then return end
+
+    local suppressed = buffs.suppressed_debuffs[target.name] or {}
+    buffs.suppressed_debuffs[target.name] = suppressed
+    for bid,_ in pairs(known) do
+        local debuff = res.buffs[bid]
+        if debuff ~= nil and debuff_map[debuff.en] == removalSpellName then
+            suppressed[bid] = true
+            known[bid] = nil
+            atc(8, ('Suppressing %s on %s: %s returned No effect. '
+                ..'HealBot will reconsider it after the effect disappears.'):format(
+                debuff.en, target.name, removalSpellName))
+        end
+    end
+end
